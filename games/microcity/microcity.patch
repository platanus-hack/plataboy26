+void HandleInput(uint8_t input)
+{
+	LoadStateCode();
+	switch (UIState.state)
+	{
+	case ShowingToolbar:
+		HandleToolbarInput(input);
+		break;
+	case InGameDisaster:
+		HandleDisasterInput(input);
+		break;
+	case StartScreen:
+		HandleStartScreenInput(input);
+		break;
+	case NewCityMenu:
+		HandleNewCityInput(input);
+		break;
+	case SaveLoadMenu:
+		HandleSaveLoadInput(input);
+		break;
+	case InGame:
+		HandleInGameInput(input);
+		break;
+	case BudgetMenu:
+		HandleBudgetInput(input);
+		break;
+	}
+}
